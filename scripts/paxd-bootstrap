#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
paxd-bootstrap - detect, install ACP adapters, and configure paxd

Usage:
  scripts/paxd-bootstrap detect
  scripts/paxd-bootstrap install-adapter --harness codex
  scripts/paxd-bootstrap configure --harness codex --cloud-url URL --registration-token TOKEN
  scripts/paxd-bootstrap configure --append --cloud-url URL --agent review:claude-code
  scripts/paxd-bootstrap run --harness codex --cloud-url URL --api-key KEY --agent-id AGENT_ID

Harnesses:
  hermes       Uses: hermes acp
  gemini       Uses: gemini --acp
  codex        Uses: codex-acp, or installs/runs @zed-industries/codex-acp
  claude-code  Uses: claude-agent-acp, or installs/runs @agentclientprotocol/claude-agent-acp

Options:
  --harness NAME            hermes, gemini, codex, claude-code, auto
  --agent SPEC              name:harness[:instance_id], repeatable
  --cloud-url URL           pax-manager base URL
  --registration-token TOKEN node registration token for first bootstrap
  --api-key KEY             node API key
  --agent-id ID             cloud agent ID created under the registered node
  --instance-id ID          instance ID, default: default
  --node-name NAME          node display name for first bootstrap
  --machine-type TYPE       machine type label
  --cf-client-id ID         Cloudflare Access service token client ID
  --cf-client-secret SECRET Cloudflare Access service token secret
  --config PATH             config path, default: ~/.paxd/paxd.yaml
  --append                  Append agents instead of replacing agents
  --no-npx                  Do not use npx fallback for adapters
  --yes                     Non-interactive yes for installs/configure prompts

Examples:
  scripts/paxd-bootstrap detect
  scripts/paxd-bootstrap install-adapter --harness codex --yes
  scripts/paxd-bootstrap configure --harness claude-code --cloud-url https://app.example.com --registration-token token_...
  scripts/paxd-bootstrap configure --append --cloud-url https://app.example.com --agent review:claude-code
  scripts/paxd-bootstrap run --harness gemini --cloud-url https://app.example.com --api-key pax_... --agent-id agent_...

Notes:
  install-adapter installs only the ACP adapter layer. It does not install
  Codex/Claude/Gemini/Hermes themselves, and it does not configure account
  login, subscriptions, keychain entries, or API keys.
  configure delegates to paxd configure. On a new machine it uses a registration
  token to create the node, node API key, and hosted agent. On a configured
  machine it reuses the node API key and creates fresh hosted agents.
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

cmd=${1:-}
if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
  usage
  exit 0
fi
shift || true

harness=""
agent_specs=()
cloud_url="${PAX_CLOUD_URL:-}"
registration_token="${PAX_REGISTRATION_TOKEN:-}"
api_key="${PAX_API_KEY:-${PAX_NODE_API_KEY:-}}"
agent_id="${PAX_AGENT_ID:-}"
instance_id="${PAX_INSTANCE_ID:-default}"
node_name="${PAX_NODE_NAME:-}"
machine_type="${PAX_MACHINE_TYPE:-}"
cf_client_id="${PAX_CLOUD_CF_CLIENT_ID:-}"
cf_client_secret="${PAX_CLOUD_CF_CLIENT_SECRET:-}"
config_path="${PAXD_CONFIG:-$HOME/.paxd/paxd.yaml}"
allow_npx=1
assume_yes=0
append_agents=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --harness) harness=${2:-}; shift 2 ;;
    --agent) agent_specs+=("${2:-}"); shift 2 ;;
    --cloud-url) cloud_url=${2:-}; shift 2 ;;
    --registration-token) registration_token=${2:-}; shift 2 ;;
    --api-key) api_key=${2:-}; shift 2 ;;
    --agent-id) agent_id=${2:-}; shift 2 ;;
    --instance-id) instance_id=${2:-}; shift 2 ;;
    --node-name) node_name=${2:-}; shift 2 ;;
    --machine-type) machine_type=${2:-}; shift 2 ;;
    --cf-client-id) cf_client_id=${2:-}; shift 2 ;;
    --cf-client-secret) cf_client_secret=${2:-}; shift 2 ;;
    --config) config_path=${2:-}; shift 2 ;;
    --append) append_agents=1; shift ;;
    --no-npx) allow_npx=0; shift ;;
    --yes|-y) assume_yes=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

normalize_harness() {
  case "$1" in
    claude|claude_code) echo "claude-code" ;;
    *) echo "$1" ;;
  esac
}

adapter_package() {
  case "$1" in
    codex) echo "@zed-industries/codex-acp" ;;
    claude-code) echo "@agentclientprotocol/claude-agent-acp" ;;
    *) echo "" ;;
  esac
}

adapter_binary() {
  case "$1" in
    codex) echo "codex-acp" ;;
    claude-code) echo "claude-agent-acp" ;;
    *) echo "" ;;
  esac
}

harness_command() {
  local h
  h=$(normalize_harness "$1")
  case "$h" in
    hermes)
      have hermes || return 1
      echo "hermes acp"
      ;;
    gemini)
      have gemini || return 1
      echo "gemini --acp"
      ;;
    codex|claude-code)
      local bin pkg
      bin=$(adapter_binary "$h")
      pkg=$(adapter_package "$h")
      if have "$bin"; then
        echo "$bin"
      elif [[ "$allow_npx" == "1" ]] && have npx; then
        echo "npx -y $pkg"
      else
        return 1
      fi
      ;;
    auto)
      choose_auto_harness_command
      ;;
    *)
      return 1
      ;;
  esac
}

status_line() {
  local h="$1"
  local label command note
  label=$(normalize_harness "$h")
  if command=$(harness_command "$label" 2>/dev/null); then
    note="ready"
    if [[ "$command" == npx* ]]; then
      note="ready via npx fallback"
    fi
    printf "  %-12s %-24s %s\n" "$label" "$note" "$command"
  else
    case "$label" in
      codex)
        if ! have codex; then
          printf "  %-12s %-24s %s\n" "$label" "missing codex CLI" "install Codex first"
        else
          printf "  %-12s %-24s %s\n" "$label" "missing adapter" "install codex-acp"
        fi
        ;;
      claude-code)
        if ! have claude; then
          printf "  %-12s %-24s %s\n" "$label" "missing Claude Code" "install claude first"
        else
          printf "  %-12s %-24s %s\n" "$label" "missing adapter" "install claude-agent-acp"
        fi
        ;;
      gemini)
        printf "  %-12s %-24s %s\n" "$label" "missing Gemini CLI" "install gemini first"
        ;;
      hermes)
        printf "  %-12s %-24s %s\n" "$label" "missing Hermes" "install hermes first"
        ;;
    esac
  fi
}

detect() {
  echo "Detected ACP adapter readiness:"
  status_line codex
  status_line claude-code
  status_line gemini
  status_line hermes
}

choose_auto_harness() {
  local h
  for h in codex claude-code gemini hermes; do
    if harness_command "$h" >/dev/null 2>&1; then
      echo "$h"
      return 0
    fi
  done
  return 1
}

choose_auto_harness_command() {
  local h
  h=$(choose_auto_harness) || return 1
  harness_command "$h"
}

install_adapter() {
  local h bin pkg
  h=$(normalize_harness "${harness:-}")
  [[ -n "$h" && "$h" != "auto" ]] || die "--harness is required for install-adapter"
  case "$h" in
    codex|claude-code)
      bin=$(adapter_binary "$h")
      pkg=$(adapter_package "$h")
      if have "$bin"; then
        echo "$bin already installed at $(command -v "$bin")"
        return 0
      fi
      have npm || die "npm is required to install $pkg. Install Node.js/npm first, or use --command in paxd.yaml."
      if [[ "$assume_yes" != "1" ]]; then
        read -r -p "Install $pkg globally with npm? [y/N] " reply
        [[ "$reply" == "y" || "$reply" == "Y" ]] || die "install cancelled"
      fi
      npm install -g "$pkg"
      ;;
    gemini)
      echo "gemini uses its native ACP mode; no separate adapter install is needed"
      have gemini || die "gemini CLI is not installed"
      ;;
    hermes)
      echo "hermes uses its native ACP mode; no separate adapter install is needed"
      have hermes || die "hermes is not installed"
      ;;
    *)
      die "unsupported harness: $h"
      ;;
  esac
}

yaml_array() {
  local command_text="$1"
  local out="["
  local first=1
  local word
  # shellcheck disable=SC2206
  local words=( $command_text )
  for word in "${words[@]}"; do
    if [[ "$first" == "0" ]]; then
      out+=", "
    fi
    first=0
    word=${word//\\/\\\\}
    word=${word//\"/\\\"}
    out+="\"$word\""
  done
  out+="]"
  echo "$out"
}

write_config() {
  local h args
  h=$(normalize_harness "${harness:-auto}")
  if [[ "$h" == "auto" ]]; then
    h=$(choose_auto_harness) || die "no ready harness found. Run: $0 detect"
  fi
  [[ -n "$cloud_url" ]] || die "--cloud-url or PAX_CLOUD_URL is required"

  args=(configure --config "$config_path" --cloud-url "$cloud_url" --harness "$h")
  [[ -z "$registration_token" ]] || args+=(--registration-token "$registration_token")
  [[ -z "$node_name" ]] || args+=(--node-name "$node_name")
  [[ -z "$machine_type" ]] || args+=(--machine-type "$machine_type")
  [[ -z "$cf_client_id" ]] || args+=(--cf-client-id "$cf_client_id")
  [[ -z "$cf_client_secret" ]] || args+=(--cf-client-secret "$cf_client_secret")
  [[ "$append_agents" == "0" ]] || args+=(--append)
  [[ "$assume_yes" == "0" ]] || args+=(--yes)
  for spec in "${agent_specs[@]}"; do
    args+=(--agent "$spec")
  done
  PAX_NODE_API_KEY="$api_key" paxd "${args[@]}"
}

run_forwarder() {
  local h command_text
  h=$(normalize_harness "${harness:-auto}")
  if [[ "$h" == "auto" ]]; then
    h=$(choose_auto_harness) || die "no ready harness found. Run: $0 detect"
  fi
  command_text=$(harness_command "$h") || die "harness $h is not ready. Run: $0 detect or $0 install-adapter --harness $h"
  [[ -n "$cloud_url" ]] || die "--cloud-url or PAX_CLOUD_URL is required"
  [[ -n "$api_key" ]] || die "--api-key or PAX_API_KEY is required"
  [[ -n "$agent_id" ]] || die "--agent-id or PAX_AGENT_ID is required"

  export PAX_CLOUD_URL="$cloud_url"
  export PAX_API_KEY="$api_key"
  export PAX_AGENT_ID="$agent_id"
  export PAX_INSTANCE_ID="$instance_id"
  export PAX_CLOUD_CF_CLIENT_ID="$cf_client_id"
  export PAX_CLOUD_CF_CLIENT_SECRET="$cf_client_secret"
  export PAX_ACP_HARNESS="$h"
  export PAX_ACP_COMMAND="$command_text"
  exec paxd acp-forward
}

case "$cmd" in
  detect)
    detect
    ;;
  install-adapter)
    install_adapter
    ;;
  install)
    echo "warning: 'install' is an alias for 'install-adapter'; it does not install the harness CLI or credentials." >&2
    install_adapter
    ;;
  configure)
    write_config
    ;;
  run)
    run_forwarder
    ;;
  *)
    usage
    die "unknown command: $cmd"
    ;;
esac
